{
  "name": "hitrendy-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "starter/web"
  ],
  "scripts": {
    "web:dev": "npm run dev -w starter/web",
    "web:build": "npm run build -w starter/web",
    "web:typecheck": "npm run typecheck -w starter/web",
    "web:lint": "npm run lint -w starter/web",
    "web:test": "npm run test -w starter/web",
    "validate": "bash scripts/validate.sh",
    "validate:e2e": "bash scripts/validate-e2e.sh",
    "backend:dev": "cd starter/backend && PYTHONPATH=. python -m alembic upgrade head && PYTHONPATH=. python -m uvicorn app.main:app --reload --port 8000",
    "backend:test": "PYTHONPATH=starter/backend python -m pytest starter/backend/tests",
    "dev": "npx --yes concurrently \"npm run web:dev\" \"npm run backend:dev\""
  }
}
